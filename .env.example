# =============================================================================
# Chat IA — Sistema hoja del ecosistema SaaS multi-tenant
# Copiar a .env y completar los valores
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de datos ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/chatia_db

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Groq (LLM) ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Ecosistema SaaS ────────────────────────────────────────────────────────────
# URL del owner-dashboard (source of truth para auth, orgs y permisos)
# DEPRECATED (ADR-001) — eliminar en Sprint 2
# DASHBOARD_URL=http://localhost:3001

# ── Firebase Admin (MISMO proyecto que el owner-dashboard) ────────────────────
# Dejar vacíos para arrancar en modo dev sin auth real
# Obtener desde: Firebase Console → Proyecto → Configuración → Cuentas de servicio
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Nota: los \n en la private key deben ser literales \\n en el .env
FIREBASE_PRIVATE_KEY=

# ── Webhooks de canales (Meta / TikTok) ───────────────────────────────────────
META_APP_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes permitidos (coma-separados). Vacío = permitir todos (solo dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Plataforma chat-ia ────────────────────────────────────────────────────────
# Clave para POST /api/v1/ecosystems (registrar ecosistemas nuevos)
# Generar con: openssl rand -hex 32
PLATFORM_ADMIN_KEY=

# ── Acceso interno del ecosistema ─────────────────────────────────────────────
# Clave compartida entre microservicios del ecosistema (sass-back, ecommerce-back)
# Generar con: openssl rand -hex 32
# Esta misma clave va en CHAT_INTERNAL_API_KEY en los servicios consumidores
NEXT_PUBLIC_CHAT_IA_URL=https://chatia-backend-production.up.railway.app
CHAT_INTERNAL_API_KEY=codigo-secreto-para-acceso-interno
